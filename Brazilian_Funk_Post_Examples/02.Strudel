
// Magrao 0.5 + Chao Pisante + Vibe Ritimada — tri-layer
setcps(128/60/4)

stack(
  // ── DRUMS: magrao 0.5 ──
  s("[bd <hh oh>]*2").bank("tr909").dec(.4).gain(0.9),
  s("alesishr16_cp").struct("[~ [~ x]][[~ x]] ~ x").gain(0.75),
  s("bossdr110_oh").struct("x ~ [x x] [~[~ x]]").gain(0.6),

  // ── VIBE RITIMADA: locked groove foundation ──
  s("bd*4").gain(0.5).bank("tr909"),
  s("~ cp ~ cp").gain(0.45).room(0.2),
  s("hh*8").gain(0.18).pan(rand.range(0.3, 0.7)),

  // ── BASS: syncopated sawtooth ──
  note("<c2 c2 f2 [g2 bb2]>*2")
    .s("sawtooth")
    .lpf("<400 600 400 500>")
    .gain(0.65)
    .dec(0.25)
    .room(0.1),

  // ── TEXTURE: shimmer hats ──
  s("hh*<4 8>")
    .bank("tr909")
    .gain("<0.2 0.3>")
    .pan(sine.range(0.3, 0.7))
)
