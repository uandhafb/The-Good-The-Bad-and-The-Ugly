⏺ strudel - write (MCP)(pattern: "\n// Ousadia + Magrao + Euclid + Texture\nsetcps(132/60/4)\n\nstack(\n  // ── OUSADIA: locked
                       4-on-floor grid ──\n  s(\"bd*4\").gain(0.88),\n  s(\"~ cp ~ cp\").gain(0.72).room(0.15),\n
                       s(\"hh*8\").gain(0.22).pan(sine.range(0.3, 0.7)),\n\n  // ── MAGRAO 0.5: sparse acoustic layers ──\n
                       s(\"alesishr16_cp\").struct(\"[~ [~ x]][[~ x]] ~ x\").gain(0.65),\n  s(\"bossdr110_oh\").struct(\"x ~ [x x]
                       [~[~ x]]\").gain(0.55).pan(0.3),\n\n  // ── EUCLIDEAN RHYTHMS: polyrhythmic percussion ──\n
                       s(\"mt\").euclid(3,8).gain(0.5).cutoff(400).pan(0.7),\n
                       s(\"ht\").euclid(5,8).gain(0.42).cutoff(600).pan(0.25),\n
                       s(\"lt\").euclid(7,16).gain(0.38).cutoff(280).pan(0.6),\n  s(\"rim\").euclid(2,6).gain(0.35).room(0.3),\n\n
                       // ── TEXTURE: metallic shimmer ──\n  s(\"hh*<3 4 6 3>\")\n    .gain(\"<0.12 0.18 0.1 0.2>\")\n
                       .lpf(perlin.range(4000, 12000))\n    .pan(perlin.range(0.1, 0.9)),\n\n  // ── TEXTURE: sub drone pulse ──\n
                       note(\"c1*<1 2>\")\n    .s(\"sine\")\n    .gain(0.35)\n    .dec(\"<0.8 0.3>\")\n    .lpf(80),\n\n  // ──
                       TEXTURE: noise breath ──\n  s(\"wind\")\n    .gain(perlin.range(0.05, 0.18))\n
                       .pan(sine.slow(7).range(0.2, 0.8))\n    .lpf(perlin.range(600, 3000))\n    .room(0.8)\n)\n", auto_play: true)
