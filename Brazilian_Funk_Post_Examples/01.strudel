setcpm(125/4/2)

$: stack(
  s("[bd <hh oh>]*2").bank("tr909").dec(.4),
  s("lt").struct("[1 0 0 0]").gain(1.0).room(1).size(7),
  s("[~] [~] [~] [~] [~] [lt lt@2 lt] [~] [[lt lt] [lt lt lt lt lt]]")
    .pan(rand)
    .delayfb(1),
  sound("[~ ~ ~ cp][~ cp] [~ ~] [cp ~ ] [~] [~ cp] [~] [cp ~]"),
)


