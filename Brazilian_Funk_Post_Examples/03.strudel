⏺ Shifted to F# Enigmatic — one of the most harmonically unstable scales that exists. What makes it weird:                        
                                                                                                                                  
  - F# root but G (b2) immediately undermines it                                                                                    
  - A# augmented 2nd creates a gap that feels wrong                                                                                 
  - C diminished 4th adds tritone tension against the root                                                                          
  - F natural at the top — a semitone below the root — refuses to resolve                                                           
                                                                                                                                    
  The chords [f#,a#,d] → [g,c,e] → [f#,c,f] are basically three unsettled shapes with no home. Sounds cursed. Want to push it
  further or lock it to something?



// Bruxaria Funk 0.6 + Bruxaria Vibe — F# Enigmatic
setcps(140/60/4)

stack(
  // ── BRUXARIA FUNK 0.6 ──
  s("hardkick").struct("[~ [~ x]] [~ x] ~ [x ~]").gain(0.9),
  s("hardkick:3").struct("[x ~ ~ [x x]]").gain(0.8).lpf(200),

  // ── BRUXARIA VIBE ──
  s("[bd <hh oh>]*2").bank("garden").struct("~ x [x[x x]] x").gain(0.75),
  s("[808bd:1 <808cy 808oh>]*2").struct("~ x [x[x x]] x").gain(0.7),

  // ── BASS: F# enigmatic root movement ──
  note("<f#1 g1 c1 [d1 f1]>*2")
    .s("sawtooth")
    .lpf("<180 250 180 300>")
    .gain(0.72)
    .dec(0.4)
    .distort(0.3),

  // ── CHORDS: dissonant enigmatic voicings ──
  note("<[f#3,a#3,d4] ~ ~ [g3,c4,e4] ~ ~ [f#3,c4,f4] ~>")
    .s("sawtooth")
    .lpf(900)
    .gain(0.3)
    .room(0.75)
    .slow(2),

  // ── MELODY: enigmatic hex line ──
  note("<f#4 g4 ~ a#4 ~ c5 ~ d5 ~ e5 ~ f4 ~ ~ f#4 ~>")
    .s("sine")
    .gain(0.42)
    .delay(0.5)
    .delayt(0.5)
    .room(0.55)
    .slow(2),

  // ── TEXTURE ──
  s("hh*<4 6 8 4>")
    .gain("<0.15 0.25>")
    .pan(perlin.range(0.2, 0.8))
    .lpf(8000)
)
