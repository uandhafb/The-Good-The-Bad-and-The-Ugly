samples('github:tidalcycles/dirt-samples')
samples('github:mot4i/garden')
// Bruxaria Funk 0.6 + Bruxaria Vibe — feitico completo
setcps(140/60/4)

stack(
  // ── BRUXARIA FUNK 0.6: hard kicks, dark structure ──
  s("hardkick").struct("[~ [~ x]] [~ x] ~ [x ~]").gain(0.9),
  s("hardkick:3").struct("[x ~ ~ [x x]]").gain(0.8).lpf(200),

  // ── BRUXARIA VIBE: layered percussion grid ──
  s("[bd <hh oh>]*2").bank("garden").struct("~ x [x[x x]] x").gain(0.75),
  s("[808bd:1 <808cy 808oh>]*2").struct("~ x [x[x x]] x").gain(0.7),

  // ── BASS: dark 808 sub ──
  note("<c1 c1 eb1 [g1 f1]>*2")
    .s("sawtooth")
    .lpf("<180 250 180 300>")
    .gain(0.72)
    .dec(0.4)
    .distort(0.3),

  // ── CHORDS: bruxaria tension ──
  note("<[c3,eb3,gb3] ~ ~ [bb2,d3,f3] ~ ~ [ab2,c3,eb3] ~>")
    .s("sawtooth")
    .lpf(800)
    .gain(0.3)
    .room(0.7)
    .slow(2),

  // ── MELODY: witch hex line ──
  note("<c4 eb4 ~ gb4 ~ f4 ~ eb4 ~ ~ c4 ~ bb3 ~ ~ ~>")
    .s("sine")
    .gain(0.4)
    .delay(0.5)
    .delayt(0.5)
    .room(0.5)
    .slow(2),

  // ── TEXTURE: dark shimmer ──
  s("hh*<4 6 8 4>")
    .gain("<0.15 0.25>")
    .pan(perlin.range(0.2, 0.8))
    .lpf(8000)
)

