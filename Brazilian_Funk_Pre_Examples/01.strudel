
//1.Prompt:Generate a brazilian funk beat

//Output: only resemblance is in the tempo choice.

// brazilian funk pattern in C at 130 BPM
setcpm(130)

stack(
  // Drums
  s("bd*4, ~ cp ~ cp, hh*8"),
  
  // Bass
  note("C2 C2 C2 C2").s("sawtooth").cutoff(800),
  
  // Chords
  note("<C G Am F>").s("sawtooth").struct("1 ~ 1 ~").release(0.1).gain(0.6),
  
  // Melody
  note("f5 g5 f3 g4 d4 g3 g#4 g3").s("triangle").struct("~ 1 ~ 1 1 ~ 1 ~").delay(0.25).room(0.3).gain(0.5)
).gain(0.8)

