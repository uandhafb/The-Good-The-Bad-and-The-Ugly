setcps(102/60/4)

stack(
  // ── DRUMS: sparse ritual pulse ──
  s("bd*<4 2 2 1>").gain(0.75),
  s("~ cp ~ cp").gain(0.52).room(0.5),
  s("hh*<8 4 2 1>").gain("<0.18 0.12 0.08 0.04>").pan(sine.range(0.3, 0.7)),

  // ── LIGHT PERCUSSION ──
  s("mt").euclid(3,8).gain(0.32).cutoff(380).pan(0.3).room(0.5),
  s("rim").struct("~ ~ x ~").gain(0.26).room(0.55),

  // ── IWATO TEXTURE: bell drops ──
  note("<d5 ~ ~ d#5 ~ ~ g5 ~ ~ g#4 ~ ~ c5 ~ ~ ~>")
    .s("marimba")
    .gain(0.38)
    .pan(perlin.range(0.2, 0.8))
    .room(0.85)
    .delay(0.55)
    .delayt(0.375)
    .slow(2),

  // ── IWATO TEXTURE: cluster drone ──
  note("<[d3,d#3,g3] ~ ~ ~ [g#3,c4,d4] ~ ~ ~>")
    .s("sawtooth")
    .lpf("<480 560>")
    .gain(0.2)
    .room(0.98)
    .slow(2),

  // ── IWATO TEXTURE: sub bass breath ──
  note("<d2 ~ ~ g#1 ~ ~ c2 ~ ~>")
    .s("sine")
    .gain(0.52)
    .dec(0.7)
    .lpf(150)
    .slow(2),

  // ── IWATO TEXTURE: high shimmer ──
  note("<c5 ~ g#4 ~ d#4 ~ ~ d5>*2")
    .s("metal")
    .gain(0.15)
    .pan(sine.slow(19).range(0.1, 0.9))
    .room(0.99)
    .delay(0.6)
    .slow(2)
)
