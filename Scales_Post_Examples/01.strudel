
// Vibe Ritimada + Pelog D — gamelan groove
setcps(120/60/4)

stack(
  // ── VIBE RITIMADA: foundation groove ──
  s("bd*4").gain(0.85),
  s("~ cp ~ cp").gain(0.7).room(0.2),
  s("hh*8").gain(0.2).pan(sine.range(0.35, 0.65)),

  // ── COOL DRUMS: texture percussion ──
  s("mt").euclid(3,8).gain(0.48).cutoff(500).pan(0.25),
  s("ht").euclid(5,16).gain(0.4).cutoff(800).pan(0.75),
  s("rim").struct("~ [x ~] ~ [~ x]").gain(0.38).room(0.25),
  s("oh").struct("~ ~ x ~").gain(0.32).dec(0.15),

  // ── PELOG TEXTURE: bell arpeggio (D, D#, F, A, A#) ──
  note("<d5 d#5 f5 a5 a#5 a5 f5 d#5>")
    .s("marimba")
    .gain(0.38)
    .pan(perlin.range(0.2, 0.8))
    .room(0.65)
    .delay(0.3)
    .delayt(0.25),

  // ── PELOG TEXTURE: slow pad drone ──
  note("<[d3,f3,a#3] ~ ~ ~ [d#3,a3,d4] ~ ~ ~>")
    .s("sawtooth")
    .lpf(700)
    .gain(0.25)
    .room(0.85)
    .slow(2),

  // ── PELOG TEXTURE: bass pulse ──
  note("<d2 ~ d#2 ~ f2 ~ a2 ~>")
    .s("sine")
    .gain(0.55)
    .dec(0.35)
    .lpf(200)
    .slow(2),

  // ── PELOG TEXTURE: shimmer hits ──
  note("<a#4 ~ f4 ~ d#4 ~ a4 ~>*2")
    .s("metal")
    .gain(0.22)
    .pan(sine.slow(11).range(0.1, 0.9))
    .room(0.9)
    .delay(0.4)
    .slow(2),

  // ── SUB TEXTURE: breath noise ──
  s("hh*<2 4>")
    .gain("<0.08 0.14>")
    .lpf(perlin.range(3000, 10000))
    .pan(perlin.range(0.1, 0.9))
)
