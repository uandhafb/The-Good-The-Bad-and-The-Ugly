// Full Techno — A Harmonic Minor / 138 BPM + Alien Textures
setcps(138/60/4)

stack(
  // ── KICK ──
  s("bd*4").bank("tr909").gain(0.92).lpf(200),

  // ── CLAP + SNARE ──
  s("~ cp ~ cp").bank("tr909").gain(0.78).room(0.15),
  s("~ ~ ~ sn").bank("tr909").gain(0.55).room(0.2),

  // ── HATS ──
  s("hh*8").bank("tr909").gain("<0.28 0.22 0.32 0.18>").pan(sine.range(0.3,0.7)),
  s("oh*<2 1 2 1>").bank("tr909").gain(0.18).pan(0.6),

  // ── EUCLIDEAN PERC ──
  s("mt").euclid(3,8).gain(0.38).cutoff(500).pan(0.25),
  s("rim").euclid(5,16).gain(0.3).room(0.3).pan(0.72),

  // ── ACID BASS ──
  note("<a2 a2 [a2 c3] [e2 g2] a2 a2 [f2 a2] [e2 d3]>")
    .s("sawtooth")
    .cutoff(perlin.range(300, 1800))
    .resonance(18)
    .gain(0.72)
    .dec(0.15)
    .distort(0.2),

  // ── SUB BASS ──
  note("a1*4")
    .s("sine")
    .gain(0.5)
    .dec(0.12)
    .lpf(120),

  // ── CHORDS ──
  note("<[a3,c4,e4] ~ [f3,a3,c4] ~ [c#3,e3,g#3] ~ [g#3,b3,e4] ~>")
    .s("sawtooth")
    .lpf(perlin.range(400, 1200))
    .resonance(8)
    .gain(0.32)
    .room(0.45)
    .struct("x ~ x ~")
    .slow(2),

  // ── MELODY ──
  note("<b4 ~ a4 ~ f4 ~ g#4 ~ f4 g#4 ~ f4 e4 ~ ~ ~>")
    .s("triangle")
    .gain(0.42)
    .delay(0.3)
    .delayt(0.375)
    .room(0.4)
    .slow(2),

  // ── ALIEN TEXTURE 1: Enigmatic high drift ──
  // A, A#, C#, D#, F, G, G# — chromatic alien shimmer
  note("<a5 ~ a#5 ~ ~ c#5 ~ d#5 ~ ~ f5 ~ g5 ~ g#5 ~>")
    .s("sine")
    .gain(perlin.range(0.08, 0.22))
    .pan(perlin.range(0.0, 1.0))
    .room(0.98)
    .delay(0.7)
    .delayt(0.666)
    .lpf(perlin.range(2000, 8000))
    .slow(4),

  // ── ALIEN TEXTURE 2: Prometheus mid-float pad ──
  // A, B, C#, D#, F#, G — Scriabin mystic cluster
  note("<[a3,c#4,f#4] ~ ~ ~ ~ ~ ~ ~ [b3,d#4,g4] ~ ~ ~ ~ ~ ~ ~>")
    .s("sawtooth")
    .lpf(perlin.range(300, 900))
    .resonance(6)
    .gain(0.14)
    .room(0.99)
    .delay(0.65)
    .slow(4),

  // ── ALIEN TEXTURE 3: Enigmatic low sub drift ──
  note("<f2 ~ ~ ~ g#2 ~ ~ ~ a#2 ~ ~ ~ d#2 ~ ~ ~>")
    .s("sine")
    .gain(0.18)
    .lpf(200)
    .room(0.9)
    .slow(4),

  // ── TEXTURE: noise shimmer ──
  s("hh*<3 4 6 4>")
    .gain(perlin.range(0.06, 0.16))
    .lpf(perlin.range(5000, 14000))
    .pan(perlin.range(0.1, 0.9))
)
